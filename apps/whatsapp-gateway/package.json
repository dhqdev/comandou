{
  "name": "@comandou/whatsapp-gateway",
  "version": "0.15.4",
  "private": true,
  "description": "Serviço interno de WhatsApp (Baileys/QR Code) do Comandou: uma sessão cifrada por restaurante.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "baileys": "6.7.24",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
