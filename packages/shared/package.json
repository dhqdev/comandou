{
  "name": "@comandou/shared",
  "version": "0.8.1",
  "private": true,
  "description": "Regras e contratos compartilhados entre API e Web (dinheiro, identificadores, papéis).",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "lint": "tsc -p tsconfig.esm.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.0.0",
    "typescript": "~5.9.3"
  }
}
