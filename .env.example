# Copie para .env e troque TODOS os valores. Nunca versione o .env real.
# ---- Docker Compose (desenvolvimento local) ----
POSTGRES_PASSWORD=troque-superuser
COMANDOU_OWNER_PASSWORD=troque-owner
COMANDOU_APP_PASSWORD=troque-app
COMANDOU_PLATFORM_PASSWORD=troque-platform
# Domínio base. Local: comandou.localhost (http://<slug>.comandou.localhost:8080). Produção: comandou.com
COMANDOU_BASE_DOMAIN=comandou.localhost
HTTP_PORT=8080
# Cookie Secure exige HTTPS (true em produção).
COOKIE_SECURE=false
LOG_LEVEL=info
# Usado apenas pelo comando de provisionamento (não fica salvo em lugar nenhum).
PROVISION_ADMIN_PASSWORD=
# Chave que cifra tokens de integrações (Focus NFe, WhatsApp) no banco: 32 bytes em base64.
# Gere com: openssl rand -base64 32   (guarde fora do repositório; perder a chave exige recadastrar os tokens)
INTEGRATIONS_KEY=
# WhatsApp por QR Code (serviço whatsapp-gateway, perfil "whatsapp" no Compose).
# Token interno entre API e gateway (mínimo 24 caracteres) e chave das sessões (32 bytes base64).
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_SESSION_KEY=
# Com o perfil whatsapp ligado: http://whatsapp-gateway:3100
WHATSAPP_GATEWAY_URL=
